struct Chunk{
    BigEndian();
    uint32 sizeAndFlags<read=Str("%i, %s", this&0x00FFFFFF, ((this&0x40000000)!=0)?"sub":"root")>;
    LittleEndian();
    char ident[4];
    if(sizeAndFlags&0x40000000){
        char data[(sizeAndFlags&0x00FFFFFF)-8];   
    }
    
};

